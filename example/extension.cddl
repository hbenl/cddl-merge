browsingContext.GetTreeParametersExtension = (
  ? "moz:scope": bool
)

browsingContext.InfoExtension = (
  ? "moz:name": text,
  ? "moz:scope": "chrome" / "content",
)

session.CapabilityRequestExtension = (
  ? "moz:firefoxOptions": session.CapabilityRequestFirefoxOptions,
)

session.CapabilityRequestFirefoxOptions = {
  ? "binary": text,
  ? "args": [*text],
  ? "profile": text,
  ? "log": {
    ? "level": ("trace" / "debug" / "config" / "info" / "warn" / "error" / "fatal") .default "info"
  },
  ? "prefs": {*text => text / bool / js-int},
  ? "env": {*text => text},
  ? "androidPackage": text,
  ? "androidActivity": text,
  ? "androidDeviceSerial": text,
  ? "androidIntentArguments": [*text],
}

webExtension.InstallParametersExtension = (
  ? "moz:allowPrivateBrowsing": bool .default false,
  ? "moz:permanent": bool .default false,
)
